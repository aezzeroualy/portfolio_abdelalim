---
import '../styles/global.css';
import { getContent, getLang, homeUrl, withBase } from '../i18n';
const lang = getLang(Astro.url);
const { profile } = getContent(lang);

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.fullName} — ${profile.role}`,
  description = profile.tagline,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(homeUrl('en'), Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL(homeUrl('fr'), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(homeUrl('en'), Astro.site)} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta name="theme-color" content="#0c0909" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;700&display=swap"
    />

    <!-- Theme + JS flag before paint (no flash) -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t === 'light' || (!t && matchMedia('(prefers-color-scheme: light)').matches)) {
          d.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="noise">
    <slot />
    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
