---
import { experience } from '../data/portfolio';
---

<section id="experience" class="py-28 md:py-40">
  <div class="container-x">
    <p class="section-label mb-4" data-reveal>Experience</p>
    <h2 class="section-title" data-split>Where I've been.</h2>

    <ol data-timeline class="relative mt-16 ml-3 md:ml-0">
      <span aria-hidden="true" class="absolute top-0 bottom-0 left-0 w-px bg-[var(--line)] md:left-1/4"></span>
      <span aria-hidden="true" data-timeline-line class="absolute top-0 bottom-0 left-0 w-px origin-top bg-accent md:left-1/4"></span>

      {experience.map((e) => (
        <li data-reveal class="relative grid gap-2 pb-14 pl-8 last:pb-0 md:grid-cols-[1fr_3fr] md:gap-0 md:pl-0">
          <span aria-hidden="true" class="absolute top-1.5 left-0 size-3 -translate-x-1/2 rounded-full border-2 border-accent bg-[var(--bg)] md:left-1/4"></span>
          <p class="font-display text-sm text-muted md:pr-10 md:text-right">{e.period}</p>
          <div class="md:pl-10">
            <h3 class="font-display text-2xl font-bold">{e.role}</h3>
            <p class="text-accent">{e.company}</p>
            <p class="mt-3 max-w-xl text-muted">{e.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
