---
import { getContent, getLang, useTranslations, withBase } from '../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const { experience, education, certifications } = getContent(lang);
---

<section id="experience" class="py-20 md:py-28">
  <div class="container-x">
    <p class="section-label mb-4" data-reveal>{t('exp.label')}</p>
    <h2 class="section-title" data-split>{t('exp.title')}</h2>

    <ol data-timeline class="relative mt-16 ml-3 md:ml-0">
      <span aria-hidden="true" class="absolute top-0 bottom-0 left-0 w-px bg-[var(--line)] md:left-1/4"></span>
      <span aria-hidden="true" data-timeline-line class="absolute top-0 bottom-0 left-0 w-px origin-top bg-accent md:left-1/4"></span>

      {experience.map((e) => (
        <li data-reveal class="relative grid gap-2 pb-14 pl-8 last:pb-0 md:grid-cols-[1fr_3fr] md:gap-0 md:pl-0">
          <span aria-hidden="true" class="absolute top-1.5 left-0 size-3 -translate-x-1/2 rounded-full border-2 border-accent bg-[var(--bg)] md:left-1/4"></span>
          <p class="font-display text-sm text-muted md:pr-10 md:text-right">{e.period}</p>
          <div class="md:pl-10">
            <h3 class="font-display text-2xl font-bold">{e.role}</h3>
            <p class="text-accent">{e.company}<span class="block text-sm text-muted sm:inline"><span class="hidden sm:inline"> · </span>{e.location}</span></p>
            <p class="mt-3 max-w-xl text-muted">{e.description}</p>
            {e.highlights.length > 0 && (
              <ul class="mt-4 max-w-xl space-y-1.5 text-muted">
                {e.highlights.map((h) => (
                  <li class="flex gap-3"><span class="text-accent" aria-hidden="true">—</span>{h}</li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>

    <p class="section-label mt-20 mb-4 md:mt-24" data-reveal>{t('edu.label')}</p>
    <h2 class="section-title" data-split>{t('edu.title')}</h2>

    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {education.map((ed) => (
        <li data-reveal class="rounded-3xl border border-line bg-card p-7">
          <p class="font-display text-sm text-muted">{ed.period}</p>
          <h3 class="font-display mt-2 text-xl font-bold">{ed.title}</h3>
          <p class="mt-2 text-accent">{ed.school}</p>
        </li>
      ))}
    </ul>

    <p class="section-label mt-20 mb-4 md:mt-24" data-reveal>{t('cert.label')}</p>
    <h2 class="section-title" data-split>{t('cert.title')}</h2>

    <ul class="mt-12 grid gap-5 md:grid-cols-2">
      {certifications.map((c) => (
        <li data-reveal class="rounded-3xl border border-line bg-card p-7">
          <p class="font-display text-sm text-muted">{t('cert.issued')} {c.date}</p>
          <h3 class="font-display mt-2 text-xl font-bold">{c.title}</h3>
          <p class="mt-2 text-accent">{c.issuer}</p>
          <p class="mt-3 text-sm text-muted">{t('cert.id')} <span class="font-mono">{c.credentialId}</span></p>
          {c.href && (
            <a href={withBase(c.href)} target="_blank" rel="noopener noreferrer" class="mt-6 inline-block rounded-full border border-line px-5 py-2.5 text-sm transition-colors hover:border-accent hover:text-accent">
              {t('cert.view')} ↗
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
