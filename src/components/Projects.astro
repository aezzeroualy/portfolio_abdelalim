---
import { Image } from 'astro:assets';
import { getContent, getLang, useTranslations } from '../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const { projects } = getContent(lang);
---

<section id="projects" class="py-20 md:py-28">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="section-label mb-4" data-reveal>{t('projects.label')}</p>
        <h2 class="section-title" data-split>{t('projects.title')}</h2>
      </div>
      <p class="max-w-sm text-muted" data-reveal>
        {t('projects.intro')}
      </p>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((p, i) => (
        <article
          data-reveal
          data-tilt
          data-cursor-grow
          class="group relative flex flex-col overflow-hidden rounded-3xl border border-line bg-card p-6 will-change-transform md:p-7"
          style={`--accent:${p.accent}`}
        >
          <!-- Spotlight that follows the pointer -->
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            style="background:radial-gradient(500px circle at var(--mx,50%) var(--my,50%),color-mix(in srgb,var(--accent) 18%,transparent),transparent 60%)"
          ></div>

          <div
            class="relative mb-6 aspect-[16/10] overflow-hidden rounded-2xl border border-line"
            style="background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 25%,transparent),transparent 70%)"
          >
            {p.image ? (
              <Image
                src={p.image}
                alt={t('projects.shot', { name: p.title })}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 360px, (min-width: 768px) 50vw, 100vw"
                class="absolute inset-0 size-full object-cover object-left transition-transform duration-700 group-hover:scale-105"
              />
            ) : (
              <div class="absolute inset-0 grid place-items-center">
                <span
                  class="font-display text-6xl font-bold opacity-80 transition-transform duration-700 group-hover:scale-110 md:text-7xl"
                  style="color:var(--accent)"
                >{p.title.charAt(0)}</span>
              </div>
            )}
            <span class={`font-display absolute top-4 text-sm ${p.image ? 'right-4 rounded-full bg-black/70 px-2 py-0.5 text-white' : 'left-4 text-muted'}`}>0{i + 1}</span>
          </div>

          <div class="relative flex flex-1 flex-col">
            <h3 class="font-display text-2xl font-bold">{p.title}</h3>
            <p class="mt-3 text-muted">{p.description}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {p.tags.map((t) => <li class="rounded-full border border-line px-3 py-1 text-xs">{t}</li>)}
            </ul>
            {(p.href || p.repo) && (
              <div class="mt-auto flex gap-5 pt-6 text-sm font-semibold">
                {p.href && (
                  <a href={p.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-accent hover:underline">
                    {t('projects.visit')} <span class="transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
                  </a>
                )}
                {p.repo && <a href={p.repo} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-[var(--fg)]">{t('projects.code')}</a>}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
