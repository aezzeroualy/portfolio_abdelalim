---
import { getContent, getLang, homeUrl, languages, useTranslations } from '../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const { profile } = getContent(lang);
const other = lang === 'fr' ? 'en' : 'fr';

const links = [
  { href: '#about', label: t('nav.about') },
  { href: '#skills', label: t('nav.skills') },
  { href: '#projects', label: t('nav.projects') },
  { href: '#experience', label: t('nav.experience') },
  { href: '#contact', label: t('nav.contact') },
];
---

<div class="fixed inset-x-0 top-0 z-50 h-0.5 origin-left scale-x-0 bg-accent" data-progress></div>

<header data-header class="fixed inset-x-0 top-0 z-40">
  <div class="container-x pt-4">
    <nav
      class="flex items-center justify-between rounded-full border border-line bg-[color-mix(in_srgb,var(--bg)_70%,transparent)] px-5 py-3 backdrop-blur-xl"
      aria-label="Main"
    >
      <a href="#top" class="font-display text-lg font-bold tracking-tight">
        {profile.name}<span class="text-accent">.</span>
      </a>

      <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
        {links.map((l) => (
          <li><a href={l.href} class="transition-colors hover:text-[var(--fg)]">{l.label}</a></li>
        ))}
      </ul>

      <div class="flex items-center gap-2">
        <a
          href={homeUrl(other)}
          hreflang={other}
          lang={other}
          aria-label={t('nav.switch')}
          title={t('nav.switch')}
          class="font-display grid h-9 place-items-center rounded-full border border-line px-3 text-xs font-bold tracking-wider transition-colors hover:border-accent hover:text-accent"
        >{languages[other]}</a>
        <button
          type="button"
          data-theme-toggle
          aria-label={t('nav.theme')}
          class="grid size-9 place-items-center rounded-full border border-line transition-colors hover:border-accent"
        >
          <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
          <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <a
          href="#contact"
          class="hidden rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white transition-transform hover:scale-105 sm:inline-block"
        >{t('nav.cta')}</a>
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-label={t('nav.menu')}
          class="grid size-9 place-items-center rounded-full border border-line md:hidden"
        >
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
    </nav>

    <div data-menu class="mt-2 hidden rounded-3xl border border-line bg-card p-4 md:hidden">
      <ul class="flex flex-col gap-1">
        {links.map((l) => (
          <li><a href={l.href} class="block rounded-xl px-3 py-2 hover:bg-[var(--line)]">{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</header>
