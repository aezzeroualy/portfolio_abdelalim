---
import { getContent, getLang, useTranslations } from '../i18n';
const lang = getLang(Astro.url);
const t = useTranslations(lang);
const { about } = getContent(lang);
---

<section id="about" class="py-20 md:py-28">
  <div class="container-x grid gap-14 md:grid-cols-[1fr_1.4fr]">
    <div>
      <p class="section-label mb-4" data-reveal>{t('about.label')}</p>
      <h2 class="section-title" data-split>{t('about.title')}</h2>
    </div>

    <div class="space-y-6 text-lg leading-relaxed text-muted">
      {about.paragraphs.map((p) => <p data-reveal>{p}</p>)}

      <dl class="grid grid-cols-1 gap-4 pt-8 sm:grid-cols-3">
        {about.stats.map((s) => (
          <div data-reveal class="flex flex-col rounded-2xl border border-line bg-card p-5">
            <dt class="order-2 mt-2 text-sm">{s.label}</dt>
            <dd class="font-display text-4xl font-bold text-[var(--fg)] md:text-5xl">
              <span data-counter={s.value}>{s.value}</span><span class="text-accent">{s.suffix}</span>
            </dd>
          </div>
        ))}
      </dl>

      <p data-reveal class="text-base">
        {t('about.languages')} <span class="text-[var(--fg)]">{about.languages.join(' · ')}</span>
      </p>
    </div>
  </div>
</section>
